{
  "name": "playwright-saucedemo-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test framework for the SauceDemo storefront: Playwright, TypeScript, page objects, custom fixtures and CI reporting.",
  "license": "MIT",
  "author": "sami1507",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sami1507/playwright-saucedemo-e2e.git"
